# Copy this file to .env and fill it in. Anything starting with VITE_ is baked in at build time.

# Your live address, no trailing slash. Used for the canonical link and the share image.
VITE_SITE_URL=https://www.example.com

# Where the booking form posts JSON. A free Formspree form works:  https://formspree.io/f/xxxxxxxx
VITE_BOOKING_ENDPOINT=

# Where the Kodak Club sign-up posts JSON. Another Formspree form works, or a Mailchimp / ConvertKit proxy.
VITE_CLUB_ENDPOINT=
